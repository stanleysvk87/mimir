import { useEffect, useRef, useState } from 'react'
import { api } from '../lib/api.js'
import { useI18n } from '../i18n/I18nContext.jsx'
import Rail from './Rail.jsx'
import Markdown from '../lib/Markdown.jsx'

function todayStr() {
  return new Date().toISOString().slice(0, 10)
}

function shiftDay(day, delta) {
  const d = new Date(`${day}T00:00:00Z`)
  d.setUTCDate(d.getUTCDate() + delta)
  return d.toISOString().slice(0, 10)
}

function useSpeechToText(onResult) {
  const recRef = useRef(null)
  const [listening, setListening] = useState(false)
  const supported = typeof window !== 'undefined' && (window.SpeechRecognition || window.webkitSpeechRecognition)

  function toggle() {
    if (!supported) return
    if (listening) {
      recRef.current?.stop()
      return
    }
    const SR = window.SpeechRecognition || window.webkitSpeechRecognition
    const rec = new SR()
    rec.continuous = false
    rec.interimResults = false
    rec.onresult = (e) => onResult(e.results[0][0].transcript)
    rec.onend = () => setListening(false)
    rec.onerror = () => setListening(false)
    recRef.current = rec
    rec.start()
    setListening(true)
  }

  return { supported, listening, toggle }
}

function NewEntryForm({ onCreated, onCancel }) {
  const { t } = useI18n()
  const [title, setTitle] = useState('')
  const [body, setBody] = useState('')
  const [machine, setMachine] = useState('')
  const [followUp, setFollowUp] = useState('')
  const [isSensitive, setIsSensitive] = useState(false)
  const [file, setFile] = useState(null)
  const [related, setRelated] = useState([])
  const [commitRef, setCommitRef] = useState('')
  const [projectId, setProjectId] = useState('')
  const [projects, setProjects] = useState([])

  useEffect(() => {
    api.listProjects().then(setProjects)
  }, [])

  const speech = useSpeechToText((text) => setBody((b) => (b ? `${b} ${text}` : text)))

  useEffect(() => {
    const handle = setTimeout(() => {
      if (title.length > 3 || body.length > 10) {
        api.relatedEntries({ title, body }).then(setRelated)
      } else {
        setRelated([])
      }
    }, 400)
    return () => clearTimeout(handle)
  }, [title, body])

  async function submit(e) {
    e.preventDefault()
    if (!title && !body) return
    const entry = await api.createEntry({
      timestamp: new Date().toISOString(),
      machine,
      project_id: projectId || null,
      title,
      body,
      commit_ref: commitRef,
      source_type: 'manual_pwa',
      is_sensitive: isSensitive,
      follow_up_date: followUp || null,
    })
    if (file) await api.uploadAttachment(entry.id, file)
    onCreated(entry)
  }

  return (
    <form
      onSubmit={submit}
      className="bg-[var(--color-panel)] border border-[var(--color-border)] rounded-xl p-4 mb-5 flex flex-col gap-3"
    >
      <input
        value={title}
        onChange={(e) => setTitle(e.target.value)}
        placeholder={t.entryForm.title}
        autoFocus
        className="bg-transparent border-b border-[var(--color-border)] pb-2 text-sm outline-none focus:border-[var(--color-gold)]"
      />
      <div className="relative">
        <textarea
          value={body}
          onChange={(e) => setBody(e.target.value)}
          placeholder={t.entryForm.body}
          rows={3}
          className="w-full bg-transparent border-b border-[var(--color-border)] pb-2 pr-9 text-sm outline-none focus:border-[var(--color-gold)] resize-none"
        />
        {speech.supported && (
          <button
            type="button"
            onClick={speech.toggle}
            aria-label="Voice input"
            className={`absolute right-0 top-0 w-7 h-7 rounded-full flex items-center justify-center ${speech.listening ? 'bg-[var(--color-warning)]' : 'bg-white/5'}`}
          >
            🎙
          </button>
        )}
      </div>

      {related.length > 0 && (
        <div className="text-xs text-[var(--color-text-tertiary)]">
          You've dealt with this before:{' '}
          {related.map((r, i) => (
            <span key={r.id}>
              {i > 0 && ', '}
              <span className="text-[var(--color-blue-light)]">{r.title || r.body.slice(0, 30)}</span>
            </span>
          ))}
        </div>
      )}

      <div className="flex gap-3 flex-wrap items-center">
        <input
          value={machine}
          onChange={(e) => setMachine(e.target.value)}
          placeholder={t.entryForm.machine}
          className="bg-transparent border-b border-[var(--color-border)] pb-2 text-sm outline-none focus:border-[var(--color-gold)] w-32"
        />
        <select
          value={projectId}
          onChange={(e) => setProjectId(e.target.value)}
          className="bg-transparent border-b border-[var(--color-border)] pb-2 text-sm outline-none focus:border-[var(--color-gold)] text-[var(--color-text-secondary)]"
        >
          <option value="">{t.entryForm.project}</option>
          {projects.map((p) => (
            <option key={p.id} value={p.id}>{p.name}</option>
          ))}
        </select>
        <input
          value={commitRef}
          onChange={(e) => setCommitRef(e.target.value)}
          placeholder="commit hash"
          className="bg-transparent border-b border-[var(--color-border)] pb-2 text-sm outline-none focus:border-[var(--color-gold)] w-28 font-[family-name:var(--font-mono)]"
        />
        <input
          type="date"
          value={followUp}
          onChange={(e) => setFollowUp(e.target.value)}
          title="Follow-up reminder"
          className="bg-transparent border-b border-[var(--color-border)] pb-2 text-sm outline-none focus:border-[var(--color-gold)] text-[var(--color-text-secondary)]"
        />
        <label className="flex items-center gap-1.5 text-xs text-[var(--color-text-secondary)]">
          <input type="checkbox" checked={isSensitive} onChange={(e) => setIsSensitive(e.target.checked)} />
          sensitive
        </label>
        <label className="text-xs text-[var(--color-text-secondary)] cursor-pointer">
          📎 attach
          <input type="file" accept="image/*" className="hidden" onChange={(e) => setFile(e.target.files?.[0] || null)} />
        </label>
        {file && <span className="text-xs text-[var(--color-gold-soft)]">{file.name}</span>}
      </div>

      <div className="flex gap-2 justify-end">
        <button type="button" onClick={onCancel} className="text-sm text-[var(--color-text-secondary)] px-3 py-1.5">
          {t.entryForm.cancel}
        </button>
        <button type="submit" className="text-sm bg-[var(--color-gold)] text-[#241505] font-semibold rounded-lg px-4 py-1.5">
          {t.entryForm.save}
        </button>
      </div>
    </form>
  )
}

export default function Timeline() {
  const { t } = useI18n()
  const [day, setDay] = useState(todayStr)
  const [entries, setEntries] = useState([])
  const [showForm, setShowForm] = useState(false)
  const [threads, setThreads] = useState([])

  function reload(forDay) {
    api.listEntries({ day: forDay }).then(setEntries)
  }

  useEffect(() => {
    reload(day)
  }, [day])

  useEffect(() => {
    api.listThreads().then(setThreads)
  }, [])

  return (
    <div className="flex">
      <div className="flex-1 p-8 max-w-3xl">
        <div className="flex items-center justify-between mb-6">
          <div className="flex items-center gap-3">
            <button
              onClick={() => setDay((d) => shiftDay(d, -1))}
              aria-label={t.timeline.prevDay}
              className="w-7 h-7 rounded-lg border border-[var(--color-border)] flex items-center justify-center text-[var(--color-text-secondary)]"
            >
              ‹
            </button>
            <h1 className="text-2xl font-[family-name:var(--font-mono)]">{day}</h1>
            <button
              onClick={() => setDay((d) => shiftDay(d, 1))}
              aria-label={t.timeline.nextDay}
              className="w-7 h-7 rounded-lg border border-[var(--color-border)] flex items-center justify-center text-[var(--color-text-secondary)]"
            >
              ›
            </button>
          </div>
          <button
            onClick={() => setShowForm((s) => !s)}
            className="bg-[var(--color-gold)] text-[#241505] font-semibold rounded-lg px-4 py-2 text-sm"
          >
            + {t.timeline.newEntry}
          </button>
        </div>

        {showForm && (
          <NewEntryForm
            onCancel={() => setShowForm(false)}
            onCreated={() => {
              setShowForm(false)
              reload(day)
            }}
          />
        )}

        {entries.length === 0 && (
          <p className="text-sm text-[var(--color-text-tertiary)]">{t.timeline.empty}</p>
        )}

        <div className="relative pl-6 flex flex-col gap-4">
          {entries.length > 0 && (
            <div className="absolute left-[5px] top-1.5 bottom-1.5 w-px bg-[var(--color-border-strong)]" />
          )}
          {entries.map((e) => (
            <EntryCard key={e.id} entry={e} threads={threads} />
          ))}
        </div>
      </div>
      <Rail />
    </div>
  )
}

function AddToThread({ entryId, threads }) {
  const [open, setOpen] = useState(false)
  const [added, setAdded] = useState(false)

  async function add(threadId) {
    if (!threadId) return
    await api.addEntryToThread(threadId, entryId)
    setAdded(true)
    setOpen(false)
  }

  if (added) return <span className="text-xs text-[var(--color-success)]">✓ added to thread</span>
  if (!threads.length) return null

  return open ? (
    <select
      autoFocus
      onChange={(e) => add(e.target.value)}
      onBlur={() => setOpen(false)}
      className="bg-[var(--color-panel-raised)] border border-[var(--color-border-strong)] rounded text-xs px-1.5 py-0.5"
    >
      <option value="">pick a thread…</option>
      {threads.map((th) => (
        <option key={th.id} value={th.id}>{th.name}</option>
      ))}
    </select>
  ) : (
    <button
      type="button"
      onClick={() => setOpen(true)}
      className="text-xs text-[var(--color-text-tertiary)] hover:text-[var(--color-blue-light)]"
    >
      + thread
    </button>
  )
}

function EntryCard({ entry, threads }) {
  const [attachments, setAttachments] = useState([])

  useEffect(() => {
    api.listAttachments(entry.id).then(setAttachments)
  }, [entry.id])

  return (
    <div className="relative bg-[var(--color-panel)] border border-[var(--color-border)] rounded-xl p-4">
      <div className="absolute -left-[25px] top-5 w-2.5 h-2.5 rounded-full bg-[var(--color-ink)] border-2 border-[var(--color-gold-soft)]" />
      <div className="flex items-center gap-2 text-xs text-[var(--color-text-tertiary)] mb-1.5 flex-wrap">
        <span className="font-[family-name:var(--font-mono)] text-[var(--color-text-secondary)]">
          {entry.timestamp.slice(11, 16)}
        </span>
        {entry.machine && (
          <span className="border border-[var(--color-border-strong)] rounded-full px-2 py-0.5">{entry.machine}</span>
        )}
        {entry.project_name && <span>{entry.project_name}</span>}
        {entry.commit_ref && (
          <span className="font-[family-name:var(--font-mono)] bg-white/5 rounded px-1.5">{entry.commit_ref}</span>
        )}
        {entry.is_sensitive && <span className="text-[var(--color-warning)]">sensitive</span>}
        <span className="ml-auto"><AddToThread entryId={entry.id} threads={threads} /></span>
      </div>
      {entry.title && <h3 className="font-semibold text-sm mb-1">{entry.title}</h3>}
      {entry.body && <Markdown text={entry.body} className="text-sm text-[var(--color-text-secondary)]" />}
      {attachments.length > 0 && (
        <div className="flex gap-2 mt-3 flex-wrap">
          {attachments.map((a) => (
            <a key={a.id} href={api.attachmentUrl(entry.id, a.id)} target="_blank" rel="noreferrer">
              <img
                src={api.attachmentUrl(entry.id, a.id)}
                alt=""
                className="w-16 h-16 object-cover rounded-lg border border-[var(--color-border)]"
              />
            </a>
          ))}
        </div>
      )}
    </div>
  )
}
