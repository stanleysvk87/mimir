# cp .env.example .env  and edit

# App login password (one shared password, no multi-user)
MIMIR_PASSWORD=change-me

# Port on the host where the app runs (http://localhost:PORT)
MIMIR_PORT=8430

# AI recall/digest (optional, the app works fully without it) -- "auto"
# tries the claude CLI, then the codex CLI, then this API key, whichever
# is actually available on the host/container.
MIMIR_AI_PROVIDER_MODE=auto
MIMIR_ANTHROPIC_API_KEY=

# Optional: base URL of a Sindri instance on the same network, so entries
# linked to a Sindri script render as a real clickable link. Leave empty
# if you don't run Sindri.
MIMIR_SINDRI_URL=

# Optional: weekly digest delivery (scripts/weekly-digest.py) via the
# plain Telegram Bot API -- a dedicated bot/token, not wired to any other
# existing bot on the host. Leave both empty to skip sending.
MIMIR_TELEGRAM_BOT_TOKEN=
MIMIR_TELEGRAM_CHAT_ID=
